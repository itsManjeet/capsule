(define-macro (syscall num args...)
  (if (= (length args) 0)
    `(runtime-syscall0 ,num)
    (if (= (length args) 1)
      `(runtime-syscall1 ,num ,@args)
      (if (= (length args) 2)
        `(runtime-syscall2 ,num ,@args)
        (if (= (length args) 3)
          `(runtime-syscall3 ,num ,@args)
          (if (= (length args) 4)
            `(runtime-syscall4 ,num ,@args)
            (if (= (length args) 5)
              `(runtime-syscall5 ,num ,@args)
              (macro-error
                "syscall currently supports 0 to 5 arguments; syscall6 needs stack-argument ABI support"))))))))
